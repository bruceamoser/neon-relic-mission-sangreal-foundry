{
  "name": "neon-relic-mission-sangreal",
  "version": "1.3.1",
  "type": "module",
  "description": "Foundry VTT v14 content module for Neon Relic — Mission: Sangreal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruceamoser/neon-relic-mission-sangreal-foundry.git"
  },
